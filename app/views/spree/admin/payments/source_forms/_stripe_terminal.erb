<div class="form-group" data-hook="stripe-readers">
<strong><%= Spree.t(:select_reader) %></strong>
<br/>
<ul id="stripe-readers-list"></ul>
</div>
<div id="terminalMessage" style="visibility: hidden;"><%= Spree.t(:connection_message) %></div>

<%= link_to Spree.t(:collect_payment), 'javascript:this.collectCardPayment();', class: 'btn btn-primary btn-success', id: 'paymentButton' %>
<%= link_to Spree.t(:discover_readers), 'javascript:this.refreshReaders();', class: 'btn btn-primary', id: 'refreshReaders' %>
<%= link_to Spree.t(:cancel_payment), 'javascript:this.cancelPendingPayment();', class: 'btn btn-primary btn-danger', style: 'visibility: hidden;', id: 'cancelButton' %>

<script>
  let orderId = "<%= @order.number %>";
  let paymentMethodId = "<%= payment_method.id %>";
  let testMode = <%= payment_method.preferred_test_mode %>;
  let pendingPaymentIntentId = null;
  let selectedReaderId = null;

  function toggleButton(name) {
    var button = document.getElementById(name);
    if (button.style.visibility === "hidden") {
      button.style.visibility = "visible";
    } else {
      button.style.visibility = "hidden";
    }
  }

  client = async (method, url, body) => {
    let response = await fetch(url, {
      method: method,
      body: body,
      headers: {
        'X-Spree-Token': Spree.api_key,
        'Content-Type': 'application/json'
      }
    });

    if (response.ok) {
      return response.json();
    } else {
      let text = await response.text();
      console.log(text);
      throw new Error(text);
    }
  }

  doPost = async (url, body) => {
    return this.client('POST', url, JSON.stringify(body));
  }

  doGet = async (url) => {
    return this.client('GET', url);
  }

  createPaymentIntent = async () => {
    const formData = {
      payment: {
        amount: document.getElementById("payment_amount").value,
        payment_method_id: paymentMethodId
      }
    }
    return this.doPost(Spree.routes.terminal_api + "/create_payment_intent/" + orderId, formData);
  }

  capturePaymentIntent = async (paymentId) => {
    return this.doPost(Spree.routes.terminal_api + "/capture_payment_intent/" + orderId + "/payment/" + paymentId, {});
  }

  processPayment = async (readerId, paymentIntentId) => {
    return this.doPost(Spree.routes.terminal_api + "/process_payment", {
      reader_id: readerId,
      payment_intent_id: paymentIntentId
    });
  }

  listReaders = async () => {
    return this.doGet(Spree.routes.terminal_api + "/readers");
  }

  collectCardPayment = async () => {
    this.toggleButton("refreshReaders");
    this.toggleButton("paymentButton");
    this.toggleButton("terminalMessage");

    try {
      if (!pendingPaymentIntentId) {
        let createIntentResponse = await this.createPaymentIntent();
        pendingPaymentIntentId = createIntentResponse.payment_intent_id;
        this.paymentId = createIntentResponse.payment_id;
      }

      // Process the payment on the selected reader
      const reader = await this.processPayment(selectedReaderId, pendingPaymentIntentId);
      
      if (reader.status === 'waiting_for_input') {
        this.toggleButton("cancelButton");
      } else if (reader.status === 'processing') {
        this.toggleButton("cancelButton");
      } else if (reader.status === 'ready') {
        // Payment was successful, capture it
        const captureResult = await this.capturePaymentIntent(this.paymentId);
        pendingPaymentIntentId = null;
        console.log("Payment Successful!");
        window.location.replace(Spree.adminPathFor("orders/" + orderId + "/payments"));
      }
    } catch (e) {
      console.error(e);
      alert('Payment failed: ' + e.message);
      this.toggleButton("paymentButton");
      this.toggleButton("refreshReaders");
      this.toggleButton("terminalMessage");
      return;
    }
  };

  refreshReaders = async () => {
    await this.updateReadersView();
  }

  updateReadersView = async () => {
    try {
      const readers = await this.listReaders();
      var list = $("#stripe-readers-list");
      list.empty();
      
      readers.forEach(function(reader) {
        list.append(`<li><label><input type='radio' name='readers' value='${reader.id}'> ${reader.label} (${reader.status})</label></li>`);
      });

      // Select first reader by default if none selected
      if (!selectedReaderId && readers.length > 0) {
        selectedReaderId = readers[0].id;
        $("input[name=readers][value=" + selectedReaderId + "]").prop("checked", true);
      }

      // Update selected reader when radio changes
      $("input[name=readers]").change(function() {
        selectedReaderId = $(this).val();
      });
    } catch (e) {
      console.error(e);
      alert('Failed to list readers: ' + e.message);
    }
  }

  window.addEventListener('DOMContentLoaded', async function() {
    $("input#payment_payment_method_id_" + <%= payment_method.id %>).click(async function() {
      updateReadersView();
      // Hide the update button to avoid confusion
      $('#new_payment button[type="submit"]').hide();
    });
  });
</script>